#jinja2: lstrip_blocks: True
# GENERATED by just docs; do not edit. `just docs` renders it to rack.svg.
# The rack from devices.yaml, top to bottom, with every Cable from network.yaml.
{% set colors = {'1G': '#006EAF', '2.5G': '#C2185B', 'hdmi': '#C73500', 'usb': '#2E7D32'} %}
{% set racked = devices | dict2items | selectattr('value.rack', 'defined') | list %}
{% set path = {} %}
direction: down

rack: {
  grid-columns: 1
  grid-gap: 20
  {% for shelf in racked | map(attribute='value.rack') | unique | sort %}
  "{{ shelf }}": {
    label: "shelf {{ shelf }}"
    grid-rows: 1
    {% for d in racked if d.value.rack == shelf %}
    {% set _ = path.update({d.key: 'rack."' ~ shelf ~ '"."' ~ d.key ~ '"'}) %}
    "{{ d.key }}": {
      grid-rows: 1
      grid-gap: 8
      {% for port, p in d.value.ports.items() %}
      "{{ port }}": {shape: square; width: 40; style.stroke: "{{ colors[p.speed | default(p.kind)] | default('#888888') }}"}
      {% endfor %}
    }
    {% endfor %}
  }
  {% endfor %}
}

off-rack: {
  {% for d in devices | dict2items | rejectattr('value.rack', 'defined') %}
  {% set _ = path.update({d.key: 'off-rack."' ~ d.key ~ '"'}) %}
  "{{ d.key }}": {
    grid-rows: 1
    grid-gap: 8
    {% for port, p in d.value.ports.items() %}
    "{{ port }}": {shape: square; width: 40; style.stroke: "{{ colors[p.speed | default(p.kind)] | default('#888888') }}"}
    {% endfor %}
  }
  {% endfor %}
}

{% for c in cables %}
{% set a = c.a.split(':', 1) %}
{% set b = c.b.split(':', 1) %}
{% set kind = devices[a[0]].ports[a[1].split('/')[0]].kind %}
{{ path[a[0]] }}."{{ a[1].split('/')[0] }}" -- {{ path[b[0]] }}."{{ b[1].split('/')[0] }}": {style.stroke: "{{ colors[c.speed | default('') if kind == 'ethernet' else kind] | default('#888888') }}"; style.stroke-width: 2}
{% endfor %}

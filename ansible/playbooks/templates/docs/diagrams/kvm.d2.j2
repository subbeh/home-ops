#jinja2: lstrip_blocks: True
# GENERATED by just docs; do not edit. `just docs` renders it to kvm.svg.
# The HDMI and USB Cables from network.yaml: each Host to a KVM switch input, its output to jetkvm.
{% set colors = {'hdmi': '#C73500', 'usb': '#2E7D32'} %}
{% set kvm = [] %}
{% for c in cables %}
{% set a = c.a.split(':', 1) %}
{% if devices[a[0]].ports[a[1].split('/')[0]].kind in colors %}
{% set _ = kvm.append(c) %}
{% endif %}
{% endfor %}
direction: right

{% for c in kvm %}
{% set a = c.a.split(':', 1) %}
{% set b = c.b.split(':', 1) %}
{% set kind = devices[a[0]].ports[a[1].split('/')[0]].kind %}
"{{ a[0] }}"."{{ a[1].split('/')[0] }}" -- "{{ b[0] }}"."{{ b[1].split('/')[0] }}": {style.stroke: "{{ colors[kind] }}"; style.stroke-width: 2}
{% endfor %}

#jinja2: lstrip_blocks: True
# GENERATED by just docs; do not edit. `just docs` renders it to network.svg.
# The Networks from network.yaml with their addresses, the routers between them, the Pools
# and the tailnet routes. A Network with no edge to a router is unrouted.
{% set routers = networks.values() | selectattr('gateway', 'defined') | map(attribute='gateway') | unique | list %}
direction: right
# dagre routes edges through unrelated Network containers; elk doesn't.
vars: {d2-config: {layout-engine: elk}}

{% for name in routers %}
"{{ name }}": {shape: hexagon}
{% endfor %}

{% for name, n in networks.items() %}
"{{ name }}": {
  label: "{{ name }}\n{{ n.cidr }}{{ '\\nVLAN ' ~ n.vlan if n.vlan is defined else '' }}"
  {% for host, a in (n.addresses | default({})).items() if host not in routers %}
  "{{ host }}": "{{ host }}\n{{ a.addr if a is mapping else a }}"
  {% endfor %}
}
{% for host, a in (n.addresses | default({})).items() if host in routers %}
"{{ name }}" -- "{{ host }}": "{{ a.addr if a is mapping else a }}"
{% endfor %}
{% endfor %}

{% for name, p in pools.items() %}
"{{ name }}": "{{ name }}\n{{ p.cidr }}\nAS {{ p.asn }}" {shape: cloud}
"{{ name }}" -- "{{ p.peer }}": "BGP to AS {{ p.peer_asn }}" {style.stroke-dash: 3}
{% for host in p.announced_by %}
{% set net = networks | dict2items | selectattr('value.gateway', 'defined') | selectattr('value.gateway', 'eq', p.peer) | selectattr('value.addresses', 'contains', host) | map(attribute='key') | first %}
"{{ net }}"."{{ host }}" -> "{{ name }}": announces {style.stroke-dash: 3}
{% endfor %}
{% endfor %}

{% for name, r in tailnet_routes.items() %}
tailnet -- "{{ name }}": "{{ (r.routes | default([]) + (['exit node'] if r.exit_node | default(false) else [])) | join(', ') }}" {style.stroke: "#6A1B9A"}
{% endfor %}

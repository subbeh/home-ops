# GENERATED by just docs; do not edit. `just docs` renders it to network.svg.
# The Networks from network.yaml with their addresses, the routers between them, the Pools
# and the tailnet routes. A Network with no edge to a router is unrouted.
direction: right
# dagre routes edges through unrelated Network containers; elk doesn't.
vars: {d2-config: {layout-engine: elk}}


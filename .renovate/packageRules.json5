{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      // The sdk-sm repo also tags SDK releases; only bws-v* are CLI releases.
      description: "Bitwarden Secrets Manager CLI versions",
      matchPackageNames: ["bitwarden/sdk-sm"],
      extractVersion: "^bws-v(?<version>.+)$",
    },
    {
      // Meilisearch won't open an older index without --upgrade-db, and karakeep pins
      // the version it tests in its compose file: upgrade on purpose, together.
      description: "Meilisearch minor/major updates need dashboard approval",
      matchPackageNames: ["getmeili/meilisearch"],
      matchUpdateTypes: ["minor", "major"],
      dependencyDashboardApproval: true,
    },
    {
      description: "Reduce Terraform lock file update frequency",
      matchManagers: ["terraform"],
      matchUpdateTypes: ["lockFileMaintenance"],
      schedule: ["* * 1 * *"],
      commitMessageAction: "Update Terraform lock files",
    },
  ],
}

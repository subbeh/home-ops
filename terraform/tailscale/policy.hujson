// vi: ft=json
{
  "tagOwners": {
    // Ephemeral GitHub Actions nodes (.github/workflows/deploy.yaml).
    "tag:ci": ["autogroup:admin"],
  },

  "hosts": {
    "vps": "${vps}",
  },

  // Routes from tailnet_routes in network.yaml. Approval only happens on a route's first
  // advertisement: re-advertise (or approve in the console) routes already pending.
  "autoApprovers": {
    "routes": {
%{ for name, r in routes ~}
%{ for cidr in r.routes ~}
      "${cidr}": ["autogroup:admin"], // ${name}
%{ endfor ~}
%{ endfor ~}
    },
    "exitNode": ["autogroup:admin"],
  },

  // Access Control Lists
  "acls": [
    // Allow all connections between your own devices. Not "*": that would include tag:ci.
    {"action": "accept", "src": ["autogroup:member"], "dst": ["*:*"]},
    // CI only reaches Semaphore, through traefik.
    {"action": "accept", "src": ["tag:ci"], "dst": ["vps:443"]},
  ],

  // Define users and devices that can use Tailscale SSH.
  "ssh": [
    {
      "action": "check",
      "src":    ["autogroup:member"],
      "dst":    ["autogroup:self"],
      "users":  ["autogroup:nonroot", "root"],
    },
  ],

  // Checked by Tailscale on every plan.
  "tests": [
    {"src": "tag:ci", "accept": ["vps:443"], "deny": ["vps:22", "vps:80"]},
    // The VPS (Gatus) pings each routed Network; tests take IPs, not CIDRs.
%{ for name, r in routes ~}
%{ for cidr in r.routes ~}
    {"src": "vps", "proto": "icmp", "accept": ["${cidrhost(cidr, 1)}:0"]},
%{ endfor ~}
%{ endfor ~}
  ],

  // https://tailscale.com/kb/1097/install-opnsense#static-nat-port-mapping
  "randomizeClientPort": true,
}
